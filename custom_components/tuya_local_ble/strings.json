  "options": {
    "step": {
      "init": {
        "title": "Tuya BLE options",
        "description": "Integration options. Keep BLE connection alive controls connection maintenance; 350K protocol logging controls local diagnostic detail without changing Home Assistant's global logger level.",
        "data": {
          "keep_connected": "Keep BLE connection alive",
          "protocol_log_level": "350K protocol logging"
        },
        "data_description": {
          "keep_connected": "For the 350K, periodically keep an existing authenticated BLE session warm without forcing a sleeping lock to connect. Other supported battery locks may use this option for their persistent-connection behavior.",
          "protocol_log_level": "Off: no extra 350K diagnostics. Parsed events: decoded datapoints and timed events. Raw frames + events: also include encrypted BLE fragments and decrypted Tuya V4 payloads. Raw mode may contain credential IDs or other lock event data, so use it only while troubleshooting."
        }
      }
    }
